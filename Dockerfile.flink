FROM flink:1.20.3-scala_2.12-java17

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
    && python3 -m venv /opt/pyflink-venv \
    && /opt/pyflink-venv/bin/pip install --no-cache-dir \
        --upgrade pip \
    && /opt/pyflink-venv/bin/pip install --no-cache-dir \
        apache-flink==1.20.3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/pyflink-venv/bin:${PATH}"
ENV PYFLINK_CLIENT_EXECUTABLE="/opt/pyflink-venv/bin/python"
ENV PYFLINK_PYTHON="/opt/pyflink-venv/bin/python"

USER flink